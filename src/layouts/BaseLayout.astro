---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  preloadImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  currentPath?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; url?: string }>;
}

const {
  title = 'ComputerJy World — Entertainment, Tech tips & Occasional software reviews',
  description = 'Entertainment, Tech tips & Occasional software reviews by Eyad Salah since 2007.',
  image = 'https://www.computerjy.com/brand-identity-reference.jpeg',
  preloadImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  currentPath = Astro.url.pathname,
  noindex = false,
  breadcrumbs,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://www.computerjy.com').href;

// Schema.org JSON-LD Structured Data Graph
const schemaGraph: any[] = [];

if (type === 'article') {
  schemaGraph.push({
    '@type': 'BlogPosting',
    '@id': `${canonicalURL}#article`,
    'headline': title,
    'description': description,
    'image': [image],
    'datePublished': publishedTime || new Date().toISOString(),
    'dateModified': modifiedTime || publishedTime || new Date().toISOString(),
    'author': {
      '@type': 'Person',
      'name': 'Eyad Salah',
      'url': 'https://www.computerjy.com/contact-me',
      'sameAs': [
        'https://x.com/ComputerJy',
        'https://www.facebook.com/computerjy',
        'https://www.linkedin.com/in/computerjy',
        'https://www.instagram.com/computerjy/'
      ]
    },
    'publisher': {
      '@type': 'Organization',
      'name': 'ComputerJy World',
      'url': 'https://www.computerjy.com',
      'logo': {
        '@type': 'ImageObject',
        'url': 'https://www.computerjy.com/logo.svg'
      }
    },
    'mainEntityOfPage': {
      '@type': 'WebPage',
      '@id': canonicalURL
    }
  });
} else {
  schemaGraph.push({
    '@type': 'WebSite',
    '@id': 'https://www.computerjy.com/#website',
    'url': 'https://www.computerjy.com',
    'name': 'ComputerJy World',
    'description': 'Entertainment, Tech tips & Occasional software reviews',
    'publisher': {
      '@type': 'Person',
      'name': 'Eyad Salah',
      'url': 'https://www.computerjy.com/contact-me'
    }
  });
}

if (breadcrumbs && breadcrumbs.length > 0) {
  schemaGraph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalURL}#breadcrumb`,
    'itemListElement': breadcrumbs.map((crumb, idx) => ({
      '@type': 'ListItem',
      'position': idx + 1,
      'name': crumb.name,
      ...(crumb.url ? { 'item': new URL(crumb.url, 'https://www.computerjy.com').href } : {})
    }))
  });
}

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': schemaGraph
};
---

<!DOCTYPE html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- RSS Auto-Discovery -->
    <link rel="alternate" type="application/rss+xml" title="ComputerJy World RSS Feed" href="/rss.xml" />

    <!-- LCP Critical Image Preload -->
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="ComputerJy World" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta property="article:author" content="Eyad Salah" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ComputerJy" />
    <meta name="twitter:creator" content="@ComputerJy" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

    <!-- Speculation Rules API (Conservative Prefetching) -->
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": { "href_matches": "/*" },
            "eagerness": "conservative"
          }
        ]
      }
    </script>

    <link rel="icon" type="image/svg+xml" href="/logo-icon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B0F19" />
    <meta name="color-scheme" content="dark light" />

    <!-- RFC 9727 & RFC 8288 Discovery Links -->
    <link rel="api-catalog" type="application/linkset+json" href="/.well-known/api-catalog" />
    <link rel="service-desc" type="application/vnd.oai.openapi+json;version=3.0" href="/api/openapi.json" />
    <link rel="describedby" type="application/json" href="/search-index.json" />
    <link rel="service-doc" type="text/html" href="https://developer.wordpress.org/rest-api/" />
    <link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />

    <!-- WebMCP API: Expose Browser Tools to AI Agents (Idle Loaded) -->
    <script is:inline>
      (function() {
        function registerWebMcp() {
          const tools = [
            {
              name: 'search_articles',
              description: 'Search across 413+ historical tech tutorials, guides, and humor articles on ComputerJy World',
              inputSchema: {
                type: 'object',
                properties: {
                  query: { type: 'string', description: 'Search term or keywords' }
                },
                required: ['query']
              },
              execute: async function(params) {
                try {
                  const res = await fetch('/search-index.json');
                  const data = await res.json();
                  const q = (params.query || '').toLowerCase();
                  const results = data.filter(function(p) {
                    return (p.title && p.title.toLowerCase().includes(q)) || 
                           (p.excerpt && p.excerpt.toLowerCase().includes(q));
                  }).slice(0, 5);
                  return { success: true, results: results };
                } catch (e) {
                  return { success: false, error: e.message };
                }
              }
            },
            {
              name: 'get_latest_articles',
              description: 'Fetch the most recent tech and entertainment articles from ComputerJy World',
              inputSchema: {
                type: 'object',
                properties: {
                  limit: { type: 'number', description: 'Number of articles to fetch (max 10)' }
                }
              },
              execute: async function(params) {
                try {
                  const limit = Math.min(params.limit || 5, 10);
                  const res = await fetch('/search-index.json');
                  const data = await res.json();
                  return { success: true, articles: data.slice(0, limit) };
                } catch (e) {
                  return { success: false, error: e.message };
                }
              }
            }
          ];

          if (typeof navigator !== 'undefined' && navigator.modelContext) {
            if (typeof navigator.modelContext.registerTool === 'function') {
              tools.forEach(function(tool) {
                try { navigator.modelContext.registerTool(tool); } catch(e) {}
              });
            } else if (typeof navigator.modelContext.provideContext === 'function') {
              try { navigator.modelContext.provideContext({ tools: tools }); } catch(e) {}
            }
          }
          if (typeof window !== 'undefined' && window.modelContext) {
            if (typeof window.modelContext.registerTool === 'function') {
              tools.forEach(function(tool) {
                try { window.modelContext.registerTool(tool); } catch(e) {}
              });
            } else if (typeof window.modelContext.provideContext === 'function') {
              try { window.modelContext.provideContext({ tools: tools }); } catch(e) {}
            }
          }
        }

        if ('requestIdleCallback' in window) {
          requestIdleCallback(registerWebMcp, { timeout: 2500 });
        } else {
          window.addEventListener('load', function() {
            setTimeout(registerWebMcp, 1000);
          });
        }
        document.addEventListener('astro:page-load', function() {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(registerWebMcp);
          } else {
            registerWebMcp();
          }
        });
      })();
    </script>

    <!-- Google Fonts (Non-blocking async load) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      rel="preload" 
      as="style" 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" 
    />
    <link 
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" 
      rel="stylesheet" 
      media="print" 
      onload="this.media='all'" 
    />
    <noscript>
      <link 
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" 
        rel="stylesheet" 
      />
    </noscript>

    <!-- Google Analytics (GA4 - Idle Loaded) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MYP6LK1T99');

      function initGA() {
        if (window._gaLoaded) return;
        window._gaLoaded = true;
        const gaScript = document.createElement('script');
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-MYP6LK1T99';
        gaScript.async = true;
        document.head.appendChild(gaScript);
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(initGA, { timeout: 3000 });
      } else {
        window.addEventListener('load', function() {
          setTimeout(initGA, 1500);
        });
      }

      // Track virtual page views across Astro ViewTransitions page swaps
      document.addEventListener('astro:after-swap', function() {
        gtag('event', 'page_view', {
          page_title: document.title,
          page_location: window.location.href,
          page_path: window.location.pathname
        });
      });
    </script>

    <!-- Zero-FOUC Theme Script (Default: Dark Theme) -->
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            const savedTheme = localStorage.getItem('computerjy_theme_pref');
            // Default to dark Cyber aesthetic unless user explicitly chose light
            const activeTheme = savedTheme === 'light' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', activeTheme);
            if (activeTheme === 'dark') {
              document.documentElement.classList.add('dark');
              document.documentElement.classList.remove('light');
            } else {
              document.documentElement.classList.add('light');
              document.documentElement.classList.remove('dark');
            }
          } catch (e) {}
        }

        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
        document.addEventListener('astro:page-load', applyTheme);
      })();
    </script>

    <ClientRouter />
  </head>
  <body class="flex flex-col min-h-screen">
    
    <Header currentPath={currentPath} />

    <div class="flex-grow">
      <slot />
    </div>

    <Footer />

    <SearchModal />

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 px-4 py-2.5 rounded-full text-xs font-bold text-white bg-slate-900 dark:bg-white dark:text-slate-900 shadow-2xl translate-y-20 opacity-0 transition-all duration-300 pointer-events-none"></div>

    <!-- Client Scripts -->
    <script>
      function setupClientFeatures() {
        // 1. Theme Switcher
        const themeBtn = document.getElementById('themeToggleBtn');
        if (themeBtn) {
          themeBtn.onclick = () => {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            if (next === 'dark') {
              document.documentElement.classList.add('dark');
              document.documentElement.classList.remove('light');
            } else {
              document.documentElement.classList.add('light');
              document.documentElement.classList.remove('dark');
            }
            localStorage.setItem('computerjy_theme_pref', next);
            showToast(`Switched to ${next} mode`);
          };
        }

        // 2. Search Modal
        const searchModal = document.getElementById('searchModal');
        const searchInput = document.getElementById('searchModalInput') as HTMLInputElement | null;
        const searchTrigger = document.getElementById('searchTrigger');
        const closeSearchBtn = document.getElementById('closeSearchBtn');

        function openSearch() {
          if (!searchModal) return;
          searchModal.classList.remove('opacity-0', 'pointer-events-none');
          searchModal.querySelector('#searchCard')?.classList.remove('-translate-y-4');
          setTimeout(() => searchInput?.focus(), 50);
        }

        function closeSearch() {
          if (!searchModal) return;
          searchModal.classList.add('opacity-0', 'pointer-events-none');
          searchModal.querySelector('#searchCard')?.classList.add('-translate-y-4');
        }

        if (searchTrigger) searchTrigger.onclick = openSearch;
        if (closeSearchBtn) closeSearchBtn.onclick = closeSearch;
        if (searchModal) {
          searchModal.onclick = (e) => {
            if (e.target === searchModal) closeSearch();
          };
        }

        const handleSearchKeydown = (e: KeyboardEvent) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            searchModal?.classList.contains('opacity-0') ? openSearch() : closeSearch();
          }
          if (e.key === 'Escape' && searchModal && !searchModal.classList.contains('opacity-0')) {
            closeSearch();
          }
        };

        document.removeEventListener('keydown', (document as any)._searchKeyHandler);
        (document as any)._searchKeyHandler = handleSearchKeydown;
        document.addEventListener('keydown', handleSearchKeydown);

        // 3. Back to Top
        const backToTop = document.getElementById('backToTopBtn');
        if (backToTop) {
          backToTop.onclick = (e) => {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          };
        }

        // 4. Code Block Copy Buttons
        document.querySelectorAll('.prose-custom pre').forEach((pre) => {
          if (pre.querySelector('.code-copy-btn')) return;
          const btn = document.createElement('button');
          btn.className = 'code-copy-btn absolute top-2.5 right-2.5 px-2.5 py-1 text-[11px] font-bold rounded-md bg-white/10 text-white hover:bg-white/20 transition-all cursor-pointer';
          btn.textContent = 'Copy';
          btn.onclick = () => {
            const code = pre.querySelector('code')?.innerText || (pre as HTMLElement).innerText;
            navigator.clipboard.writeText(code).then(() => {
              btn.textContent = 'Copied! ✓';
              btn.classList.add('bg-emerald-600');
              setTimeout(() => {
                btn.textContent = 'Copy';
                btn.classList.remove('bg-emerald-600');
              }, 2000);
            });
          };
          pre.appendChild(btn);
        });

        // 5. Copy Share Link
        const shareCopyBtn = document.getElementById('copyShareLinkBtn');
        if (shareCopyBtn) {
          shareCopyBtn.onclick = () => {
            navigator.clipboard.writeText(window.location.href).then(() => {
              showToast('Article link copied to clipboard! 📋');
            });
          };
        }
      }

      function showToast(msg: string) {
        const toast = document.getElementById('toast');
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.remove('translate-y-20', 'opacity-0');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 2500);
      }

      document.addEventListener('astro:page-load', setupClientFeatures);
    </script>
  </body>
</html>
