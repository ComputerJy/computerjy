---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import BentoShowcase from '../components/BentoShowcase.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Pagination from '../components/Pagination.astro';
import { getPosts, getCategories, getTags } from '../lib/api';
import { PAGE_SIZE, feedWindow, feedPageCount } from '../lib/feed';

const posts = await getPosts();
const categories = await getCategories();
const tags = await getTags();

const featuredPost = posts[0];
const sidePosts = posts.slice(1, 4);
// The bento re-features the newest posts rather than consuming them: the feed
// withholds only the hero, so it always leads with the second-newest post.
const feedPosts = feedWindow(posts).slice(0, PAGE_SIZE);
const totalPages = feedPageCount(posts.length);
---

<BaseLayout currentPath="/" preloadImage={featuredPost?.featuredImageUrl}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <!-- Hero Banner -->
    <HeroBanner />

    <!-- Bento Featured Section -->
    {
      featuredPost && (
        <BentoShowcase featuredPost={featuredPost} sidePosts={sidePosts} />
      )
    }

    <!-- Main Content & Sidebar Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Feed Stream (8 cols) -->
      <div class="lg:col-span-8">
        <div
          class="flex items-center justify-between pb-3 mb-6 border-b-2 border-slate-200/80 dark:border-slate-800"
        >
          <h2
            class="text-xl sm:text-2xl font-heading font-black text-slate-900 dark:text-white flex items-center gap-2.5"
          >
            <span class="w-2.5 h-6 rounded-sm bg-grad-primary"></span>
            Latest Articles &amp; Insights
          </h2>
          <span class="badge-glow text-[11px]">Fresh Content</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
          {feedPosts.map((post) => <PostCard post={post} />)}
        </div>

        <!-- Working Responsive Pagination -->
        <Pagination currentPage={1} totalPages={totalPages} />
      </div>

      <!-- Sidebar (4 cols) -->
      <aside class="lg:col-span-4">
        <Sidebar categories={categories} tags={tags} trendingPosts={posts} />
      </aside>
    </div>
  </main>
</BaseLayout>
