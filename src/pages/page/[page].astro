---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import Pagination from '../../components/Pagination.astro';
import { getPosts, getCategories, getTags } from '../../lib/api';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  const feedPosts = posts.slice(4); // Exclude top 4 featured
  return paginate(feedPosts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const posts = await getPosts();
const categories = await getCategories();
const tags = await getTags();
---

<BaseLayout
  title={`Articles — Page ${page.currentPage} — ComputerJy World`}
  description={`Browse historical articles, software reviews and tech tips on ComputerJy World - Page ${page.currentPage}.`}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <div class="mb-8">
      <h1
        class="text-2xl sm:text-3xl font-heading font-black text-slate-900 dark:text-white flex items-center gap-2.5"
      >
        <span class="w-2.5 h-6 rounded-sm bg-grad-primary"></span>
        All Articles (Page {page.currentPage})
      </h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Feed Stream (8 cols) -->
      <div class="lg:col-span-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-10">
          {page.data.map((post) => <PostCard post={post} />)}
        </div>

        <!-- Working Responsive Pagination -->
        <Pagination currentPage={page.currentPage} totalPages={page.lastPage} />
      </div>

      <!-- Sidebar (4 cols) -->
      <aside class="lg:col-span-4">
        <Sidebar categories={categories} tags={tags} trendingPosts={posts} />
      </aside>
    </div>
  </main>
</BaseLayout>
