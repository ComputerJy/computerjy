---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found | ComputerJy World">
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center">
    
    <div class="inline-block mb-6">
      <img src="/logo-icon.svg" alt="ComputerJy Mascot" class="w-24 h-24 mx-auto drop-shadow-lg" />
    </div>

    <div class="text-7xl sm:text-8xl font-heading font-black text-gradient leading-none mb-4">404</div>
    <h1 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 dark:text-white mb-3">
      Oops! Page Unplugged
    </h1>
    <p class="text-base text-slate-500 dark:text-slate-400 mb-8 max-w-md mx-auto">
      The page you were looking for might have been moved, renamed, or temporarily unplugged.
    </p>

    <div class="flex items-center justify-center gap-3">
      <a href="/" class="px-5 py-2.5 rounded-xl font-bold text-sm text-white bg-grad-accent hover:shadow-glow-orange transition-all">
        🏠 Back to Home
      </a>
      <a href="/category/computers" class="px-5 py-2.5 rounded-xl font-bold text-sm bg-white dark:bg-dark-surface border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-brand-blue transition-all">
        Explore Tech Tips &rarr;
      </a>
    </div>

  </main>
</BaseLayout>
