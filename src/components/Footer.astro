---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto bg-white dark:bg-dark-surface border-t border-slate-200/60 dark:border-slate-800/80 pt-16 pb-8 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-14">
      
      <!-- Col 1: Brand Info -->
      <div class="flex flex-col gap-4">
        <a href="/" class="flex items-center">
          <img src="/logo.svg" alt="ComputerJy World" class="h-9 w-auto" width="180" height="36" />
        </a>
        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
          Entertainment, Tech tips &amp; Occasional software reviews. Exploring the modern web, software wonders, and digital culture with energy and curiosity since 2007.
        </p>
        
        <!-- Social Profiles -->
        <div class="flex items-center gap-2 pt-2">
          <a href="https://x.com/ComputerJy" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full flex items-center justify-center bg-light-subtle dark:bg-dark-subtle border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-brand-blue hover:text-white transition-all shadow-xs" aria-label="Twitter / X">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.facebook.com/computerjy" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full flex items-center justify-center bg-light-subtle dark:bg-dark-subtle border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-brand-blue hover:text-white transition-all shadow-xs" aria-label="Facebook">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/computerjy" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full flex items-center justify-center bg-light-subtle dark:bg-dark-subtle border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-brand-blue hover:text-white transition-all shadow-xs" aria-label="LinkedIn">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.45 1.45 0 0 0 1.45-1.45 1.45 1.45 0 0 0-1.45-1.45 1.45 1.45 0 0 0 1.45 1.45m1.37 9.74v-8.37H5.09v8.37h2.74z"/></svg>
          </a>
          <a href="https://www.instagram.com/computerjy/" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full flex items-center justify-center bg-light-subtle dark:bg-dark-subtle border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:bg-brand-blue hover:text-white transition-all shadow-xs" aria-label="Instagram">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Categories -->
      <div>
        <h4 class="font-heading font-bold text-sm text-slate-900 dark:text-white uppercase tracking-wider mb-4 relative pb-2 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-8 after:h-0.5 after:bg-brand-blue">
          Categories &amp; Topics
        </h4>
        <ul class="flex flex-col gap-2.5 text-sm text-slate-500 dark:text-slate-400">
          <li><a href="/category/g33ky" class="hover:text-brand-blue transition-colors">💻 Geeky &amp; Tech Tips (101)</a></li>
          <li><a href="/category/entertainment" class="hover:text-brand-blue transition-colors">🎉 Entertainment &amp; Fun (327)</a></li>
          <li><a href="/tag/computers" class="hover:text-brand-blue transition-colors">⚡ Computers &amp; Hardware</a></li>
          <li><a href="/tag/programming" class="hover:text-brand-blue transition-colors">🛠️ Programming &amp; Web</a></li>
        </ul>
      </div>

      <!-- Col 3: Quick Links -->
      <div>
        <h4 class="font-heading font-bold text-sm text-slate-900 dark:text-white uppercase tracking-wider mb-4 relative pb-2 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-8 after:h-0.5 after:bg-brand-blue">
          Quick Links
        </h4>
        <ul class="flex flex-col gap-2.5 text-sm text-slate-500 dark:text-slate-400">
          <li><a href="/" class="hover:text-brand-blue transition-colors">🏠 Home</a></li>
          <li><a href="/contact-me" class="hover:text-brand-blue transition-colors">✉️ Contact Me</a></li>
          <li><a href="/privacy-policy" class="hover:text-brand-blue transition-colors">🔒 Privacy Policy</a></li>
          <li><a href="/rss.xml" class="hover:text-brand-blue transition-colors">📡 RSS Feed</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter -->
      <div>
        <h4 class="font-heading font-bold text-sm text-slate-900 dark:text-white uppercase tracking-wider mb-4 relative pb-2 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-8 after:h-0.5 after:bg-brand-blue">
          Stay Updated
        </h4>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">
          Get weekly tech tips and software curiosities delivered directly to your inbox.
        </p>
        <form class="flex flex-col gap-2" onsubmit="event.preventDefault(); alert('Thank you for subscribing to ComputerJy World! 🚀');">
          <input 
            type="email" 
            placeholder="Your email address" 
            required 
            class="px-3.5 py-2 text-sm rounded-lg bg-light-subtle dark:bg-dark-subtle border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:border-brand-blue"
          />
          <button 
            type="submit" 
            class="px-4 py-2 text-sm font-bold rounded-lg text-white bg-grad-primary hover:shadow-glow-blue transition-all"
          >
            Subscribe 🚀
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-200/60 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <div>
        &copy; {currentYear} <strong>ComputerJy World</strong> &bull; Crafted with passion by <a href="/contact-me" class="text-brand-blue font-semibold hover:underline">Eyad Salah</a>.
      </div>
      <button 
        id="backToTopBtn" 
        type="button" 
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-light-subtle dark:bg-dark-subtle border border-slate-200 dark:border-slate-800 hover:text-brand-blue transition-all font-semibold"
      >
        <span>Back to top</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"></polyline></svg>
      </button>
    </div>

  </div>
</footer>
