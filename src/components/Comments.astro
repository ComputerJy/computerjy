---
interface Props {
  postId: number;
}

const { postId } = Astro.props;
---

<section
  class="mt-14 pt-10 border-t border-slate-200/80 dark:border-slate-800"
  id="comments"
>
  <div class="flex items-center justify-between mb-8">
    <h3
      class="text-xl sm:text-2xl font-heading font-black text-slate-900 dark:text-white flex items-center gap-2.5"
    >
      <span class="w-2.5 h-6 rounded-sm bg-grad-primary"></span>
      Discussion <span id="commentsHeadingCount"></span>
    </h3>
    <span class="text-xs text-slate-400 font-semibold"
      >Powered by WordPress</span
    >
  </div>

  <!-- Comments List -->
  <div class="flex flex-col gap-5 mb-10" id="commentsListContainer">
    <div
      id="commentsLoading"
      class="flex flex-col gap-5"
      aria-live="polite"
      aria-busy="true"
    >
      {
        [0, 1].map(() => (
          <div class="bg-light-subtle dark:bg-dark-subtle border border-slate-200/70 dark:border-slate-800 rounded-2xl p-5 flex gap-4 items-start animate-pulse">
            <div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-800 flex-shrink-0" />
            <div class="flex-grow flex flex-col gap-2">
              <div class="h-3 w-32 rounded bg-slate-200 dark:bg-slate-800" />
              <div class="h-3 w-full rounded bg-slate-200 dark:bg-slate-800" />
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Comment Submission Form -->
  <div
    class="bg-white dark:bg-dark-surface border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xs"
  >
    <h4
      class="font-heading font-bold text-base sm:text-lg text-slate-900 dark:text-white mb-2 flex items-center gap-2"
    >
      <span>✍️ Leave a Thought</span>
    </h4>
    <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">
      Your email address will not be published. Required fields are marked *
    </p>

    <form id="wpCommentForm" data-post-id={postId} class="flex flex-col gap-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label
            for="commentAuthor"
            class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5"
            >Name *</label
          >
          <input
            type="text"
            id="commentAuthor"
            name="author_name"
            required
            placeholder="Your name"
            class="w-full px-4 py-2.5 text-xs sm:text-sm rounded-xl bg-light-subtle dark:bg-dark-subtle border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:border-brand-blue"
          />
        </div>
        <div>
          <label
            for="commentEmail"
            class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5"
            >Email *</label
          >
          <input
            type="email"
            id="commentEmail"
            name="author_email"
            required
            placeholder="Your email (kept private)"
            class="w-full px-4 py-2.5 text-xs sm:text-sm rounded-xl bg-light-subtle dark:bg-dark-subtle border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:border-brand-blue"
          />
        </div>
      </div>

      <div>
        <label
          for="commentContent"
          class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1.5"
          >Comment *</label
        >
        <textarea
          id="commentContent"
          name="content"
          rows="4"
          required
          placeholder="Share your thoughts, questions, or insights..."
          class="w-full px-4 py-3 text-xs sm:text-sm rounded-xl bg-light-subtle dark:bg-dark-subtle border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:border-brand-blue resize-y"
        ></textarea>
      </div>

      <!-- Status Notice Container -->
      <div
        id="commentStatusNotice"
        class="hidden text-xs font-semibold p-3 rounded-xl"
      >
      </div>

      <div class="flex items-center justify-between pt-2">
        <span class="text-[11px] text-slate-400"
          >Protected by WordPress comment moderation</span
        >
        <button
          type="submit"
          id="submitCommentBtn"
          class="px-6 py-2.5 rounded-xl font-bold text-xs sm:text-sm text-white bg-grad-primary hover:shadow-glow-blue transition-all disabled:opacity-50"
        >
          Post Comment 🚀
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  import { commentsEndpoint, toCommentViews } from '../lib/comments';
  import type { CommentView } from '../lib/comments';

  function escapeText(value: string): string {
    const el = document.createElement('span');
    el.textContent = value;
    return el.innerHTML;
  }

  function commentMarkup(view: CommentView): string {
    const date = new Date(view.date).toLocaleDateString('en-GB');
    return `
      <div class="bg-light-subtle dark:bg-dark-subtle border border-slate-200/70 dark:border-slate-800 rounded-2xl p-5 flex gap-4 items-start">
        <div class="w-10 h-10 rounded-full bg-grad-primary text-white font-black text-sm flex items-center justify-center flex-shrink-0 shadow-sm">${escapeText(view.initial)}</div>
        <div class="flex-grow">
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="font-heading font-bold text-sm text-slate-900 dark:text-white">${escapeText(view.author)}</span>
            <span class="text-[11px] text-slate-400">${escapeText(date)}</span>
          </div>
          <div class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed prose-sm">${view.html}</div>
        </div>
      </div>`;
  }

  const EMPTY_MARKUP = `
    <div class="text-center py-8 px-4 rounded-2xl bg-light-subtle dark:bg-dark-subtle border border-dashed border-slate-200 dark:border-slate-800 text-xs text-slate-400">
      No comments yet on this article. Be the first to join the conversation! 👇
    </div>`;

  const FAILED_MARKUP = `
    <div class="text-center py-8 px-4 rounded-2xl bg-light-subtle dark:bg-dark-subtle border border-dashed border-slate-200 dark:border-slate-800 text-xs text-slate-400">
      Comments could not be loaded right now. Please refresh to try again.
    </div>`;

  function setCount(count: number | null) {
    const heading = document.getElementById('commentsHeadingCount');
    if (heading) heading.textContent = count === null ? '' : `(${count})`;
    const badge = document.getElementById('postCommentCount');
    if (badge) {
      badge.textContent =
        count === null ? '💬 Comments' : `💬 ${count} Comments`;
    }
  }

  async function loadComments(postId: number, bust = false) {
    const container = document.getElementById('commentsListContainer');
    if (!container) return;

    try {
      const response = await fetch(commentsEndpoint(postId, bust), {
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);

      const views = toCommentViews(await response.json());
      container.innerHTML =
        views.length > 0 ? views.map(commentMarkup).join('') : EMPTY_MARKUP;
      setCount(views.length);
    } catch {
      // Deliberately not a success message. A read that failed must read as
      // failed — the write path told visitors their comment was saved when it
      // was not, and that bug is not repeated here.
      container.innerHTML = FAILED_MARKUP;
      setCount(null);
    }
  }

  function setupCommentLoading() {
    const form = document.getElementById(
      'wpCommentForm'
    ) as HTMLFormElement | null;
    const section = document.getElementById('comments');
    if (!form || !section) return;

    const postId = Number(form.dataset.postId);
    if (!Number.isFinite(postId) || postId <= 0) return;

    // Lazy on purpose: most readers never reach the comments, and every fetch
    // that does happen boots WordPress on Lightsail. The static site exists to
    // keep front-end traffic off that host.
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void loadComments(postId);
      },
      { rootMargin: '200px' }
    );
    observer.observe(section);
  }

  document.addEventListener('astro:page-load', setupCommentLoading);

  const STATUS_CLASSES = {
    success: ['bg-emerald-500/10', 'text-emerald-500'],
    error: ['bg-red-500/10', 'text-red-500'],
  };

  function showStatus(
    notice: HTMLElement | null,
    kind: 'success' | 'error',
    message: string
  ) {
    if (!notice) return;
    notice.classList.remove(
      'hidden',
      ...STATUS_CLASSES.success,
      ...STATUS_CLASSES.error
    );
    notice.classList.add(...STATUS_CLASSES[kind]);
    notice.textContent = message;
  }

  function setupCommentSubmission() {
    const form = document.getElementById(
      'wpCommentForm'
    ) as HTMLFormElement | null;
    if (!form) return;

    form.onsubmit = async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById(
        'submitCommentBtn'
      ) as HTMLButtonElement | null;
      const statusNotice = document.getElementById('commentStatusNotice');
      const postId = form.dataset.postId;

      const authorName = (
        document.getElementById('commentAuthor') as HTMLInputElement
      ).value.trim();
      const authorEmail = (
        document.getElementById('commentEmail') as HTMLInputElement
      ).value.trim();
      const content = (
        document.getElementById('commentContent') as HTMLTextAreaElement
      ).value.trim();

      if (!postId || !authorName || !authorEmail || !content) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Posting... ⏳';
      }

      try {
        const response = await fetch(
          'https://www.computerjy.com/wp-json/wp/v2/comments',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              post: parseInt(postId, 10),
              author_name: authorName,
              author_email: authorEmail,
              content: content,
            }),
          }
        );

        if (response.ok) {
          showStatus(
            statusNotice,
            'success',
            '🎉 Thank you! Your comment has been submitted for moderation and will appear shortly.'
          );
          form.reset();
          void loadComments(Number(postId), true);
        } else {
          const errData = await response.json().catch(() => ({}));
          showStatus(
            statusNotice,
            'error',
            errData.message ||
              `Sorry, your comment could not be posted (error ${response.status}). Please try again later.`
          );
        }
      } catch (err) {
        showStatus(
          statusNotice,
          'error',
          'Sorry, your comment could not be sent. Please check your connection and try again.'
        );
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Post Comment 🚀';
        }
      }
    };
  }

  document.addEventListener('astro:page-load', setupCommentSubmission);
</script>
