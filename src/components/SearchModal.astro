---

---

<div
  id="searchModal"
  class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm flex items-start justify-center pt-[15vh] px-4 opacity-0 pointer-events-none transition-all duration-200"
>
  <div
    class="w-full max-w-xl bg-white dark:bg-dark-surface border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl overflow-hidden -translate-y-4 transition-transform duration-200"
    id="searchCard"
  >
    <!-- Search Header -->
    <div
      class="flex items-center gap-3 px-5 py-4 border-b border-slate-100 dark:border-slate-800"
    >
      <svg
        class="w-5 h-5 text-brand-blue"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        viewBox="0 0 24 24"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="searchModalInput"
        type="search"
        placeholder="Search 400+ articles by title or keyword..."
        class="w-full text-sm sm:text-base font-medium text-slate-900 dark:text-white bg-transparent focus:outline-none placeholder:text-slate-400"
        autocomplete="off"
      />
      <button
        id="closeSearchBtn"
        type="button"
        class="text-xs font-mono px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        ESC
      </button>
    </div>

    <!-- Suggested / Results List -->
    <div class="p-3 max-h-96 overflow-y-auto" id="searchResultsContainer">
      <div
        class="px-3 py-2 text-[11px] font-bold text-slate-400 uppercase tracking-wider flex items-center justify-between"
        id="searchCountHeader"
      >
        <span>Suggested Articles</span>
        <span class="text-[10px] text-slate-400 lowercase font-normal"
          >⌘K anytime</span
        >
      </div>
      <div id="searchResultsList" class="flex flex-col gap-1">
        <!-- Results populated dynamically -->
      </div>
    </div>
  </div>
</div>

<script>
  interface SearchItem {
    id: number;
    title: string;
    slug: string;
    date: string;
    category: string;
    excerpt: string;
  }

  let searchIndex: SearchItem[] = [];
  let indexLoaded = false;

  async function loadSearchIndex() {
    if (indexLoaded) return;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        searchIndex = await res.json();
        indexLoaded = true;
        renderResults(searchIndex.slice(0, 5), 'Featured Articles');
      }
    } catch (e) {}
  }

  function renderResults(items: SearchItem[], headerTitle = 'Results') {
    const listEl = document.getElementById('searchResultsList');
    const headerEl = document.getElementById('searchCountHeader');
    if (!listEl) return;

    if (headerEl) {
      headerEl.innerHTML = `<span>${headerTitle} (${items.length})</span><span class="text-[10px] text-slate-400 lowercase font-normal">Instant Search</span>`;
    }

    if (items.length === 0) {
      listEl.innerHTML = `
        <div class="text-center py-8 px-4 text-xs text-slate-400">
          No articles found matching your search. Try another keyword!
        </div>
      `;
      return;
    }

    listEl.innerHTML = items
      .map(
        (item) => `
      <a href="/posts/${item.slug}" class="flex flex-col p-3 rounded-2xl hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors group">
        <div class="flex items-center justify-between gap-2 mb-1">
          <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-brand-blue transition-colors line-clamp-1">
            ${item.title}
          </span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 font-semibold flex-shrink-0">
            ${item.category}
          </span>
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 line-clamp-1 leading-relaxed">
          ${item.excerpt}...
        </p>
      </a>
    `
      )
      .join('');
  }

  function setupSearchEvents() {
    const searchInput = document.getElementById(
      'searchModalInput'
    ) as HTMLInputElement | null;
    const searchTrigger = document.getElementById('searchTrigger');
    const drawerSearchTrigger = document.getElementById('drawerSearchTrigger');

    if (searchTrigger) searchTrigger.addEventListener('click', loadSearchIndex);
    if (drawerSearchTrigger)
      drawerSearchTrigger.addEventListener('click', loadSearchIndex);

    const onSearchKey = (e: KeyboardEvent) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        loadSearchIndex();
      }
    };

    document.removeEventListener(
      'keydown',
      (document as any)._searchIndexKeyHandler
    );
    (document as any)._searchIndexKeyHandler = onSearchKey;
    document.addEventListener('keydown', onSearchKey);

    if (searchInput) {
      searchInput.oninput = (e) => {
        const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
        if (!q) {
          renderResults(searchIndex.slice(0, 5), 'Suggested Articles');
          return;
        }

        const matches = searchIndex.filter(
          (item) =>
            item.title.toLowerCase().includes(q) ||
            item.category.toLowerCase().includes(q) ||
            item.excerpt.toLowerCase().includes(q)
        );

        renderResults(matches.slice(0, 10), `Found ${matches.length} articles`);
      };
    }
  }

  document.addEventListener('astro:page-load', () => {
    setupSearchEvents();
    if (indexLoaded)
      renderResults(searchIndex.slice(0, 5), 'Suggested Articles');
  });
</script>
