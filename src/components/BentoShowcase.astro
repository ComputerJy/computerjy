---
import type { WPPost } from '../lib/types';

interface Props {
  featuredPost: WPPost;
  sidePosts: WPPost[];
}

const { featuredPost, sidePosts } = Astro.props;
---

<section class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-12">
  <!-- Main Featured Bento Card (7 cols) - LCP Candidate -->
  <article
    class="lg:col-span-7 bg-white dark:bg-dark-surface border border-slate-200/80 dark:border-slate-800 rounded-3xl overflow-hidden flex flex-col group hover:-translate-y-1 hover:shadow-glow-blue hover:border-brand-blue/40 transition-all duration-300"
  >
    <a
      href={`/posts/${featuredPost.slug}`}
      class="relative aspect-video overflow-hidden bg-slate-100 dark:bg-slate-900 block"
    >
      <span
        class="absolute top-4 left-4 z-10 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-white bg-grad-primary shadow-md"
      >
        {featuredPost.primaryCategory?.name || 'Featured'}
      </span>
      <img
        src={featuredPost.featuredImageUrl}
        alt={featuredPost.title.rendered}
        width="700"
        height="394"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </a>

    <div class="p-6 sm:p-8 flex flex-col flex-grow">
      <div
        class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3"
      >
        <span>{new Date(featuredPost.date).toLocaleDateString('en-GB')}</span>
        <span class="w-1 h-1 rounded-full bg-slate-400 dark:bg-slate-600"
        ></span>
        <span>{featuredPost.readingTime || '4 min read'}</span>
        <span class="w-1 h-1 rounded-full bg-slate-400 dark:bg-slate-600"
        ></span>
        <span class="text-amber-600 dark:text-brand-amber font-semibold"
          >⭐ Featured Insight</span
        >
      </div>

      <h2
        class="text-xl sm:text-2xl font-heading font-black text-slate-900 dark:text-white mb-3 group-hover:text-brand-blue transition-colors leading-snug"
      >
        <a href={`/posts/${featuredPost.slug}`}>{featuredPost.title.rendered}</a
        >
      </h2>

      <p
        class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mb-6 line-clamp-3 leading-relaxed"
      >
        {featuredPost.excerpt.rendered.replace(/<[^>]*>/g, '')}
      </p>

      <div
        class="mt-auto pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between"
      >
        <div class="flex items-center gap-2.5">
          <img
            src="/logo-icon.svg"
            alt="Eyad Salah"
            width="28"
            height="28"
            loading="lazy"
            decoding="async"
            class="w-7 h-7 rounded-full border border-brand-cyan object-cover"
          />
          <span class="text-xs font-bold text-slate-800 dark:text-slate-200"
            >Eyad Salah</span
          >
        </div>
        <a
          href={`/posts/${featuredPost.slug}`}
          class="text-xs font-extrabold text-brand-blue flex items-center gap-1 group-hover:gap-2 transition-all"
        >
          Read Full Story &rarr;
        </a>
      </div>
    </div>
  </article>

  <!-- Secondary Stack (5 cols) -->
  <div class="lg:col-span-5 flex flex-col gap-4">
    {
      sidePosts.map((post) => (
        <article class="bg-white dark:bg-dark-surface border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 flex gap-4 items-center group hover:border-brand-blue/40 hover:translate-x-1 transition-all duration-200 shadow-xs">
          <a
            href={`/posts/${post.slug}`}
            class="w-24 h-20 rounded-xl overflow-hidden flex-shrink-0 bg-slate-100 dark:bg-slate-900 block"
          >
            <img
              src={post.featuredImageUrl}
              alt={post.title.rendered}
              width="96"
              height="80"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </a>
          <div class="flex flex-col flex-grow min-w-0">
            <span class="text-[11px] font-bold text-pink-600 dark:text-brand-pink uppercase tracking-wider mb-1">
              {post.primaryCategory?.name || 'Tech'}
            </span>
            <h3 class="text-sm font-heading font-bold text-slate-900 dark:text-white leading-snug group-hover:text-brand-blue transition-colors line-clamp-2 mb-1.5">
              <a href={`/posts/${post.slug}`}>{post.title.rendered}</a>
            </h3>
            <div class="text-[11px] text-slate-500 dark:text-slate-400">
              {new Date(post.date).toLocaleDateString('en-GB')} &bull;{' '}
              {post.readingTime}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
