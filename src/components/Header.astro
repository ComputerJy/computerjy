---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header
  class="sticky top-0 z-50 h-[72px] glass-header transition-all duration-300"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 h-full flex items-center justify-between gap-4"
  >
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/logo.svg"
        alt="ComputerJy World"
        class="h-10 sm:h-11 w-auto transition-transform duration-200 group-hover:scale-105 group-hover:-rotate-1"
        width="220"
        height="44"
      />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1">
      <a
        href="/"
        class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 ${currentPath === '/' ? 'text-brand-blue bg-light-subtle dark:bg-dark-subtle' : 'text-slate-600 dark:text-slate-300 hover:text-brand-blue hover:bg-light-subtle dark:hover:bg-dark-subtle'}`}
      >
        Home
      </a>
      <a
        href="/category/g33ky"
        class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 ${currentPath.includes('/category/g33ky') ? 'text-brand-blue bg-light-subtle dark:bg-dark-subtle' : 'text-slate-600 dark:text-slate-300 hover:text-brand-blue hover:bg-light-subtle dark:hover:bg-dark-subtle'}`}
      >
        Geeky &amp; Tech Tips
      </a>
      <a
        href="/category/entertainment"
        class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 ${currentPath.includes('/category/entertainment') ? 'text-brand-blue bg-light-subtle dark:bg-dark-subtle' : 'text-slate-600 dark:text-slate-300 hover:text-brand-blue hover:bg-light-subtle dark:hover:bg-dark-subtle'}`}
      >
        Entertainment
      </a>
      <a
        href="/contact-me"
        class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-colors duration-200 ${currentPath === '/contact-me' ? 'text-brand-blue bg-light-subtle dark:bg-dark-subtle' : 'text-slate-600 dark:text-slate-300 hover:text-brand-blue hover:bg-light-subtle dark:hover:bg-dark-subtle'}`}
      >
        Contact
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2.5">
      <!-- Search Button -->
      <button
        id="searchTrigger"
        type="button"
        class="flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium text-slate-500 dark:text-slate-400 bg-light-subtle dark:bg-dark-subtle border border-slate-200/60 dark:border-slate-800 hover:border-brand-blue/50 hover:text-slate-900 dark:hover:text-white transition-all shadow-sm"
        aria-label="Search website"
      >
        <svg
          class="w-3.5 h-3.5 text-brand-blue"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd
          class="hidden sm:inline-block font-mono text-[10px] px-1.5 py-0.5 rounded bg-white dark:bg-dark-surface border border-slate-200 dark:border-slate-700 text-slate-400"
          >⌘K</kbd
        >
      </button>

      <!-- Theme Switcher -->
      <button
        id="themeToggleBtn"
        type="button"
        class="w-10 h-10 rounded-full flex items-center justify-center bg-light-subtle dark:bg-dark-subtle border border-slate-200/60 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:text-brand-amber hover:border-brand-amber transition-all"
        aria-label="Toggle theme"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobileMenuBtn"
        type="button"
        class="md:hidden w-10 h-10 rounded-xl flex items-center justify-center bg-light-subtle dark:bg-dark-subtle border border-slate-200/60 dark:border-slate-800 text-slate-700 dark:text-slate-200 hover:text-brand-blue hover:border-brand-blue/40 transition-all cursor-pointer shadow-xs"
        aria-label="Open mobile navigation menu"
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          viewBox="0 0 24 24"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Side Navigation Backdrop Overlay -->
<div
  id="mobileDrawerBackdrop"
  class="fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  aria-hidden="true"
>
</div>

<!-- Mobile Side Navigation Drawer -->
<aside
  id="mobileDrawer"
  class="fixed top-0 right-0 bottom-0 z-50 w-[85%] max-w-sm bg-white dark:bg-dark-surface border-l border-slate-200/80 dark:border-slate-800 shadow-2xl flex flex-col justify-between translate-x-full transition-transform duration-300 ease-out md:hidden overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
  tabindex="-1"
>
  <!-- Drawer Main Body -->
  <div class="p-6 flex flex-col gap-6">
    <!-- Top Bar: Brand & Close Button -->
    <div
      class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-800"
    >
      <a href="/" class="flex items-center gap-2 group">
        <img
          src="/logo-icon.svg"
          alt="ComputerJy World"
          class="h-8 w-8 rounded-lg"
          width="32"
          height="32"
        />
        <span
          class="font-heading font-black text-lg text-slate-900 dark:text-white"
        >
          Computer<span class="text-brand-cyan">Jy</span>
        </span>
      </a>
      <button
        id="mobileDrawerCloseBtn"
        type="button"
        class="w-9 h-9 rounded-xl flex items-center justify-center bg-light-subtle dark:bg-dark-subtle border border-slate-200/80 dark:border-slate-800 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 transition-all cursor-pointer"
        aria-label="Close navigation menu"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
