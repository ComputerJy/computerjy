      </button>
    </div>

    <!-- Quick Search Action -->
    <button
      id="drawerSearchTrigger"
      type="button"
      class="flex items-center justify-between w-full px-4 py-3 rounded-2xl bg-light-subtle dark:bg-dark-subtle border border-slate-200/80 dark:border-slate-800 text-xs font-medium text-slate-500 dark:text-slate-400 hover:border-brand-blue/50 hover:text-slate-900 dark:hover:text-white transition-all shadow-xs cursor-pointer"
    >
      <div class="flex items-center gap-2.5">
        <svg
          class="w-4 h-4 text-brand-blue"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
