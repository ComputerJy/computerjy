  <!-- Drawer Footer: Theme & Socials -->
  <div
    class="p-6 border-t border-slate-100 dark:border-slate-800 bg-light-subtle/50 dark:bg-dark-subtle/50 flex flex-col gap-4"
  >
    <!-- Theme Toggle inside Drawer -->
