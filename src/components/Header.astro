<script>
  function setupMobileDrawer() {
    const btn = document.getElementById('mobileMenuBtn');
    const closeBtn = document.getElementById('mobileDrawerCloseBtn');
    const backdrop = document.getElementById('mobileDrawerBackdrop');
    const drawer = document.getElementById('mobileDrawer');
    const drawerSearchBtn = document.getElementById('drawerSearchTrigger');
    const drawerThemeBtn = document.getElementById('drawerThemeToggleBtn');
    const drawerThemeLabel = document.getElementById('drawerThemeStateLabel');

    if (!btn || !backdrop || !drawer) return;

    function updateThemeLabel() {
      if (!drawerThemeLabel) return;
      const currentTheme =
        document.documentElement.getAttribute('data-theme') || 'dark';
      drawerThemeLabel.textContent = currentTheme;
    }

    function openDrawer() {
      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100', 'pointer-events-auto');
      backdrop?.setAttribute('aria-hidden', 'false');

      drawer?.classList.remove('translate-x-full');
      drawer?.classList.add('translate-x-0');

      btn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      updateThemeLabel();
    }

    function closeDrawer() {
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      backdrop?.classList.remove('opacity-100', 'pointer-events-auto');
      backdrop?.setAttribute('aria-hidden', 'true');

      drawer?.classList.add('translate-x-full');
      drawer?.classList.remove('translate-x-0');

      btn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    // Toggle button on header
    btn.onclick = (e) => {
      e.stopPropagation();
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeDrawer();
      } else {
        openDrawer();
      }
    };

    // Close button inside drawer
    if (closeBtn) {
      closeBtn.onclick = (e) => {
        e.stopPropagation();
        closeDrawer();
      };
    }

    // Backdrop click closes drawer
    backdrop.onclick = (e) => {
      if (e.target === backdrop) {
        closeDrawer();
      }
    };

    // Drawer links close the drawer on click
    drawer.querySelectorAll('a').forEach((link) => {
      link.onclick = () => {
        closeDrawer();
      };
    });

    // Drawer search trigger opens search modal and closes drawer
    if (drawerSearchBtn) {
      drawerSearchBtn.onclick = () => {
        closeDrawer();
        const searchTrigger = document.getElementById('searchTrigger');
        searchTrigger?.click();
      };
    }

    // Drawer theme toggle
    if (drawerThemeBtn) {
      drawerThemeBtn.onclick = () => {
        const themeBtn = document.getElementById('themeToggleBtn');
        themeBtn?.click();
        setTimeout(updateThemeLabel, 50);
      };
    }

    // Escape key closes drawer
    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        closeDrawer();
      }
    };

    document.removeEventListener(
      'keydown',
      (document as any)._drawerEscapeHandler
    );
    (document as any)._drawerEscapeHandler = onKeyDown;
    document.addEventListener('keydown', onKeyDown);
  }

  // Clean up body overflow and close drawer on Astro page navigation swap
  document.addEventListener('astro:before-swap', () => {
    document.body.style.overflow = '';
  });

  // Initialize on Astro page load
  document.addEventListener('astro:page-load', setupMobileDrawer);
</script>
