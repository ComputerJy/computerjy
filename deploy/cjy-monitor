#!/bin/sh
# Forced command for the GitHub Actions monitor key (cert-expiry-monitor.yml and
# cloudflare-ip-monitor.yml). The key logs in as `cjy-monitor`, which can run
# only these two read-only commands, so a leaked key cannot get a shell or root.
#
# Installed on the origin as /usr/local/sbin/cjy-monitor (root, 755), with:
#
#   /etc/sudoers.d/cjy-monitor (440, check with `visudo -cf` before installing):
#     cjy-monitor ALL=(root) NOPASSWD: /usr/bin/openssl x509 -in /etc/letsencrypt/live/computerjy.com/cert.pem -noout -enddate -ext subjectAltName, /usr/sbin/ufw status
#
#   /home/cjy-monitor/.ssh/authorized_keys (600, owned by cjy-monitor):
#     restrict,command="/usr/local/sbin/cjy-monitor" ssh-ed25519 AAAA… github-actions-monitor
#
# The user has no password (`usermod -p '*'`). Its private key is the
# LIGHTSAIL_SSH_KEY secret and LIGHTSAIL_USER is `cjy-monitor`.
case "$SSH_ORIGINAL_COMMAND" in
  cert) exec sudo -n /usr/bin/openssl x509 -in /etc/letsencrypt/live/computerjy.com/cert.pem -noout -enddate -ext subjectAltName ;;
  ufw)  exec sudo -n /usr/sbin/ufw status ;;
  *)    echo "cjy-monitor: only 'cert' or 'ufw' allowed" >&2; exit 1 ;;
esac
