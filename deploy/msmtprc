# /etc/msmtprc -- system sendmail for the ComputerJy origin.
#
# WordPress (wp_mail -> PHPMailer -> PHP mail()) shells out to
# /usr/sbin/sendmail, which the msmtp-mta package points at msmtp. Without it
# every comment/password-reset mail died with
# "sh: 1: /usr/sbin/sendmail: not found" in /var/log/wp-cron.log (#87).
#
# Install:
#   sudo apt-get install -y msmtp msmtp-mta
#   sudo install -m 644 deploy/msmtprc /etc/msmtprc
#   sudo sh -c 'umask 027; printf "%s\n" "<google app password>" > /etc/msmtp-password'
#   sudo chown root:www-data /etc/msmtp-password   # PHP-FPM + the wp-cron job run as www-data
#   printf 'Subject: msmtp test\n\nok\n' | sudo -u www-data sendmail -t computerjy@gmail.com
#
# The password file is the only secret and never lives in the repo.

defaults
auth            on
tls             on
tls_trust_file  /etc/ssl/certs/ca-certificates.crt
syslog          on
timeout         20

account         gmail
host            smtp.gmail.com
port            587
from            computerjy@gmail.com
user            computerjy@gmail.com
passwordeval    "cat /etc/msmtp-password"

account default : gmail
