{
  "name": "computerjy-2",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "ComputerJy 2.0 WordPress theme — test and deploy tooling (the theme itself has no build step)",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:php": "find . -maxdepth 3 -name \"*.php\" -not -path \"*/node_modules/*\" -not -path \"*/vendor/*\" -exec php -l {} +",
    "lint": "npm run format:check && npm run lint:php"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  }
}
