{
  "name": "computerjy-world-frontend",
  "type": "module",
  "version": "1.0.0",
  "description": "Headless JAMstack frontend for ComputerJy World built with Astro 7 & Tailwind CSS",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:build": "node scripts/verify-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:php": "find . -maxdepth 3 -name \"*.php\" -not -path \"*/node_modules/*\" -not -path \"*/dist/*\" -not -path \"*/.astro/*\" -exec php -l {} +",
    "lint": "npm run format:check && npm run lint:php"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
