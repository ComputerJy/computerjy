# ==============================================================================
# Environment Configuration for ComputerJy World (Keep private, never commit .env)
# ==============================================================================

# AWS Lightsail Deployment Configuration
SERVER_HOST=your_lightsail_ip_here
SERVER_USER=ubuntu
KEY_PATH=${HOME}/.ssh/lightsail.pem
REMOTE_DEST=/var/www/computerjy_dist
# WordPress root on the origin (deploy/deploy-theme.sh)
WP_ROOT=/var/www/wordpress

# Google Analytics 4
PUBLIC_GA_MEASUREMENT_ID=G-0E6WH95Q6Z
