<?xml version="1.0"?>
<ruleset name="ComputerJy Security &amp; Quality Ruleset">
    <description>Enterprise security and code quality standards for ComputerJy WordPress theme</description>

    <!-- Scan PHP files only -->
    <arg name="extensions" value="php" />
    <arg name="colors" />
    <arg value="sp" />
    <arg name="parallel" value="8" />

    <!-- Minimum WordPress & PHP version targets -->
    <config name="minimum_wp_version" value="6.0" />
    <config name="testVersion" value="8.0-" />

    <!-- Directories to scan -->
    <file>.</file>
    <file>./template-parts</file>
    <file>./inc</file>

    <!-- Directories to ignore -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/.astro/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/public/*</exclude-pattern>

    <!-- 1. Security & Database Injection Protections -->
    <rule ref="WordPress.Security" />
    <rule ref="WordPress.DB.PreparedSQL" />
    <rule ref="WordPress.DB.RestrictedFunctions" />

    <!-- 2. Safe WordPress API Wrappers -->
    <rule ref="WordPress.WP.AlternativeFunctions" />
    <rule ref="WordPress.WP.CapitalPDangit" />

    <!-- 3. Prevent Deprecated WordPress Functions & Parameters -->
    <rule ref="WordPress.WP.DeprecatedFunctions" />
    <rule ref="WordPress.WP.DeprecatedParameters" />
    <rule ref="WordPress.WP.DeprecatedClasses" />

    <!-- 4. Internationalization & Text Domain Consistency -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="computerjy" />
            </property>
        </properties>
    </rule>

    <!-- 5. Prevent Overwriting WordPress Global Variables -->
    <rule ref="WordPress.WP.GlobalVariablesOverride" />

    <!-- 6. Flag Discouraged & Leftover Debug Functions -->
    <rule ref="WordPress.WP.DiscouragedFunctions" />

    <!-- 7. Enforce Theme Function & Hook Prefixing -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="computerjy" />
            </property>
        </properties>
    </rule>
</ruleset>
