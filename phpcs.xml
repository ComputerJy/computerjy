<?xml version="1.0"?>
<ruleset name="ComputerJy Security Ruleset">
    <description>Security and Best Practice rules for ComputerJy WordPress theme</description>

    <!-- Scan PHP files only -->
    <arg name="extensions" value="php" />
    <arg name="colors" />
    <arg value="s" />

    <!-- Directories to scan -->
    <file>.</file>
    <file>./template-parts</file>
    <file>./inc</file>

    <!-- Directories to ignore -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/.astro/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/public/*</exclude-pattern>

    <!-- Include WordPress Security and Database safety sniffs -->
    <rule ref="WordPress.Security" />
    <rule ref="WordPress.WP.CapitalPDangit" />
    <rule ref="WordPress.WP.AlternativeFunctions" />
    <rule ref="WordPress.DB.PreparedSQL" />
    <rule ref="WordPress.DB.RestrictedFunctions" />
</ruleset>
