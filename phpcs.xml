<?xml version="1.0"?>
<ruleset name="ComputerJy Security Ruleset">
    <description>Security and Best Practice rules for ComputerJy WordPress theme</description>

    <!-- Scan PHP files only -->
    <arg name="extensions" value="php" />
    <arg name="colors" />
    <arg value="s" />

    <!-- Directories to scan -->
    <file>.</file>
    <file>./template-parts</file>
    <file>./inc</file>

    <!-- Directories to ignore -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/.astro/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>

    <!-- Include WordPress Security sniffs -->
    <rule ref="WordPress.Security" />
    <rule ref="WordPress.WP.CapitalPDangit" />
    <rule ref="WordPress.WP.AlternativeFunctions" />

    <!-- Include WordPress-Extra while excluding cosmetic whitespace/tab indentation rules -->
    <rule ref="WordPress-Extra">
        <exclude name="Generic.WhiteSpace.DisallowSpaceIndent" />
        <exclude name="Generic.WhiteSpace.ScopeIndent" />
        <exclude name="WordPress.WhiteSpace" />
        <exclude name="PEAR.Functions.FunctionCallSignature" />
        <exclude name="Squiz.Commenting" />
        <exclude name="WordPress.Files.FileName" />
    </rule>
</ruleset>
